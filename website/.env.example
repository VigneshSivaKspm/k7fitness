# Firebase web app configuration (Firebase Console → Project settings → Your apps)
# Both website/ and admin/ use the SAME Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Development only: connect to the local Firebase Emulator Suite instead of production
# (see README → "Local development with emulators").
VITE_USE_EMULATORS=false

# Public URL of the website (makes social-share image links absolute, adds canonical URL)
VITE_SITE_URL=
