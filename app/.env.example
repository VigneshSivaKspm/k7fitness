# Firebase web app configuration (Firebase Console → Project settings → Your apps)
# Both website/ and admin/ use the SAME Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public website URL (used for "View website" links inside the admin)
VITE_WEBSITE_URL=http://localhost:5173

# Development only: connect to the local Firebase Emulator Suite instead of production
# (see README → "Local development with emulators").
VITE_USE_EMULATORS=false

# TEMPORARY dev-only login bypass: signs in a dev admin automatically during `npm run dev`.
# Never active in production builds. Remove when no longer needed.
VITE_DEV_AUTH_BYPASS=false
VITE_DEV_ADMIN_EMAIL=
VITE_DEV_ADMIN_PASSWORD=

# Serve the admin from a sub-path when website + admin share one domain (e.g. /admin/).
# Leave empty when the admin has its own domain/project.
VITE_BASE_PATH=
